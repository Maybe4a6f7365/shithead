{
  "name": "shithead-game",
  "private": true,
  "version": "0.2.0",
  "description": "Shithead — the classic shedding card game. PWA + multiplayer.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run && node scripts/animationPerformance.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate:build-meta": "node scripts/write-build-meta.mjs",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "deploy:build": "npm run generate:build-meta && npm run typecheck:worker && npm run build",
    "worker:dev": "wrangler dev --local",
    "test:worker:adversarial": "node scripts/test-worker-adversarial.mjs",
    "worker:deploy": "npm run deploy:build && wrangler deploy",
    "worker:tail": "wrangler tail",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.11.17",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260808.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.4",
    "autoprefixer": "^10.5.4",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.4",
    "wrangler": "^4.120.0"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "workerd@1.20260801.1": true,
    "esbuild@0.28.1": true
  }
}
