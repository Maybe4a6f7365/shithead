{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    "allowJs": true
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/__tests__/**/*",
    "src/vite-env.d.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "tailwind.config.js"
  ],
  "exclude": ["node_modules", "dist"]
}
